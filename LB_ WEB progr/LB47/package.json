{
  "name": "router-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "json-server db.json --port 3001",
    "dev": "concurrently -k -n db,web \"npm:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "json-server": "^1.0.0-beta.15",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}